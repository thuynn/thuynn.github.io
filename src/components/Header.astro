---
import { NAV, SITE } from '../site';

const path = Astro.url.pathname;
const isActive = (href: string) => path.startsWith(href);
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-bg/80 backdrop-blur">
  <nav class="container-page flex h-16 items-center justify-between gap-4" aria-label="Main">
    <a href="/" class="flex shrink-0 items-center gap-2 font-semibold tracking-tight whitespace-nowrap">
      <span
        class="grid size-8 place-items-center rounded-full bg-accent font-mono text-sm font-bold text-accent-fg"
        aria-hidden="true">tn</span
      >
      <span>{SITE.name}</span>
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      <ul class="flex items-center text-sm">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class="rounded-full px-1.5 py-1.5 text-muted transition-colors hover:text-fg aria-[current=page]:bg-accent-soft aria-[current=page]:text-accent sm:px-3"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <button
        id="theme-toggle"
        type="button"
        class="grid size-9 place-items-center rounded-full text-muted transition-colors hover:bg-accent-soft hover:text-accent"
        aria-label="Toggle dark mode"
      >
        <svg class="size-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" stroke-linejoin="round"></path>
        </svg>
        <svg class="hidden size-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke-linecap="round"></path>
        </svg>
      </button>
    </div>
  </nav>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', dark ? 'dark' : 'light');
  });
</script>
