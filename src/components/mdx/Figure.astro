---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  wide?: boolean;
}

const { src, alt, caption, wide = false } = Astro.props;
---

<figure class:list={['not-prose my-10', wide && 'lg:-mx-24']}>
  <Image src={src} alt={alt} widths={[640, 1024, 1600]} sizes="(min-width: 1024px) 960px, 100vw" class="w-full rounded-xl border border-line" />
  {caption && <figcaption class="mt-3 text-center text-sm text-muted">{caption}</figcaption>}
</figure>
