---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
  <section class="container-page grid min-h-[60vh] place-content-center text-center">
    <p class="font-mono text-6xl font-semibold text-accent">404</p>
    <h1 class="mt-4 text-2xl font-semibold tracking-tight">This page took a different user flow.</h1>
    <p class="mt-2 text-muted">The link may be broken or the page may have moved.</p>
    <a href="/" class="btn-primary mx-auto mt-8">Back to home</a>
  </section>
</BaseLayout>
