---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Figure from '../../components/mdx/Figure.astro';
import Callout from '../../components/mdx/Callout.astro';
import { formatDate, getPosts, readingTime } from '../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, lang, tags } = post.data;
const minutes = readingTime(post.body ?? '');
---

<BaseLayout title={title} description={description} lang={lang}>
  <article class="container-page pt-16">
    <header class="mx-auto max-w-3xl">
      <a href="/blog/" class="text-sm text-muted hover:text-accent">← {lang === 'vi' ? 'Tất cả bài viết' : 'All posts'}</a>
      <h1 class="mt-8 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{title}</h1>
      <p class="mt-4 text-lg text-muted">{description}</p>
      <p class="mt-6 flex flex-wrap items-center gap-x-4 gap-y-2 font-mono text-xs text-muted">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {updated && <span>Updated {formatDate(updated)}</span>}
        <span>{minutes} min read</span>
        {tags.map((t) => <a href={`/blog/tags/${t}/`} class="hover:text-accent">#{t}</a>)}
      </p>
    </header>
    <div class="prose-page mx-auto mt-10 max-w-3xl border-t border-line pt-10">
      <Content components={{ Figure, Callout }} />
    </div>
  </article>
</BaseLayout>
