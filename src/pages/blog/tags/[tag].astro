---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostItem from '../../../components/PostItem.astro';
import { getPosts } from '../../../utils';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`#${tag}`}>
  <section class="container-page pt-16 pb-6">
    <a href="/blog/" class="text-sm text-muted hover:text-accent">← All posts</a>
    <h1 class="mt-6 text-4xl font-semibold tracking-tight">#{tag}</h1>
  </section>
  <section class="container-page">
    {posts.map((post) => <PostItem post={post} />)}
  </section>
</BaseLayout>
