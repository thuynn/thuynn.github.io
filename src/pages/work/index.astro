---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getWork } from '../../utils';

const work = await getWork();
---

<BaseLayout
  title="Work"
  description="Case studies as chapters of one practice: understand the problem, choose what matters first, then design something a team can keep."
>
  <section class="container-page pt-16 pb-8">
    <p class="eyebrow">Work</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight sm:text-5xl">Chapters</h1>
    <p class="mt-4 max-w-2xl text-lg text-muted text-pretty">
      Each case study is a chapter of the same way of thinking: understand the problem, choose what matters first,
      then design something a team can ship and keep. Course projects are labeled as such.
    </p>
  </section>
  <section class="container-page grid gap-6 md:grid-cols-2">
    {work.map((entry, i) => <WorkCard entry={entry} priority={i < 2} />)}
  </section>
</BaseLayout>
