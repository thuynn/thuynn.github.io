---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuietPath from '../components/QuietPath.astro';
import PillarFocus from '../components/PillarFocus.astro';
import WorkCard from '../components/WorkCard.astro';
import { getWork } from '../utils';
import { SITE } from '../site';

const work = (await getWork()).filter((entry) => entry.data.featured);

const lenses: Record<string, string> = {
  'spectos-design-system': 'product technology',
  covigo: 'problem design',
  'alpha-design-system': 'design technology',
};

const steps = [
  {
    name: 'Discover',
    text: 'Listen to users, constraints, and the business goal before drawing.',
  },
  {
    name: 'Define',
    text: 'Name the real problem in one sentence a team can agree on.',
  },
  {
    name: 'Strategize',
    text: 'Choose what to solve first, and what can wait.',
  },
  {
    name: 'Design',
    text: 'Shape a flow that is clear to use and concrete enough to build.',
  },
  {
    name: 'Validate',
    text: 'Check it with people, with the system, and with the team who will maintain it.',
  },
];
---

<BaseLayout>
  <QuietPath />

  <section id="hero" class="container-page scroll-mt-24 pt-16 pb-8 sm:pt-24">
    <div class="grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div>
        <p class="eyebrow">Strategic Product-minded Designer</p>
        <h1 class="mt-5 max-w-3xl text-4xl leading-[1.12] font-semibold tracking-tight text-balance sm:text-6xl">
          I turn complex problems into meaningful product experiences.
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-muted text-pretty">
          I connect user needs, product goals, design and technology to create thoughtful, practical digital experiences.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#chapters" class="btn-primary">Explore my work</a>
          <a href="/about/" class="btn-ghost">About me</a>
        </div>
      </div>
      <div class="hero-mark text-line" aria-hidden="true">
        <svg viewBox="0 0 160 160" class="size-36 sm:size-44">
          <circle cx="80" cy="80" r="62" fill="none" stroke="var(--lavender)" stroke-width="1"></circle>
          <circle cx="80" cy="80" r="34" fill="none" stroke="currentColor" stroke-width="1"></circle>
          <path d="M80 80 L128 46" fill="none" stroke="currentColor" stroke-width="1"></path>
          <circle cx="80" cy="80" r="5" fill="var(--accent)"></circle>
          <circle cx="128" cy="46" r="3.5" fill="var(--sage)"></circle>
        </svg>
      </div>
    </div>
  </section>

  <div id="story" data-focus="">
    <PillarFocus />

    <section id="chapters" class="container-page reveal scroll-mt-24 py-16" aria-labelledby="chapters-heading">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="eyebrow">Selected work</p>
          <h2 id="chapters-heading" class="mt-2 text-3xl font-semibold tracking-tight">Three chapters</h2>
          <p class="mt-3 max-w-xl text-muted">Each one shows a different part of the same practice.</p>
        </div>
        <a href="/work/" class="shrink-0 text-sm font-medium text-accent hover:underline">All work</a>
      </div>
      <div class="mt-8 grid gap-6 lg:grid-cols-3">
        {
          work.map((entry, index) => (
            <div data-lens={lenses[entry.id] ?? ''}>
              <WorkCard entry={entry} priority={index < 2} />
            </div>
          ))
        }
      </div>
    </section>
  </div>

  <section id="approach" class="container-page reveal scroll-mt-24 py-16" aria-labelledby="approach-heading">
    <p class="eyebrow">My approach</p>
    <h2 id="approach-heading" class="mt-2 max-w-2xl text-3xl font-semibold tracking-tight">
      Discover, then decide, then design
    </h2>
    <div class="relative mt-10 max-w-2xl pl-8">
      <span class="approach-path" aria-hidden="true"></span>
      <ol class="space-y-8">
        {
          steps.map((step, index) => (
            <li class="relative">
              <span
                class:list={[
                  'absolute top-1.5 -left-8 size-2.5 -translate-x-1/2 rounded-full border-2 border-bg',
                  index === 0 ? 'bg-sage' : 'bg-accent',
                ]}
                aria-hidden="true"
              />
              <h3 class="font-semibold">{step.name}</h3>
              <p class="mt-1 text-sm text-pretty text-muted">{step.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section id="close" class="container-page reveal scroll-mt-24 pt-16 pb-8" aria-labelledby="close-heading">
    <p class="eyebrow">About</p>
    <h2 id="close-heading" class="mt-3 max-w-2xl text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
      I believe great product design starts with understanding the real problem.
    </h2>
    <p class="mt-5 max-w-xl text-lg text-pretty text-muted">
      I'm Thuy — a designer who still builds. Eighteen-plus years in digital products, most of them making complex
      enterprise interfaces clear enough for a team to keep.
    </p>
    <p class="mt-8 flex items-center gap-3 text-lg">
      <span class="size-2 shrink-0 rounded-full bg-coral" aria-hidden="true"></span>
      Think strategically. Design creatively. Build meaningfully.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/about/" class="btn-primary">About me</a>
      <a href={SITE.cv} class="btn-ghost">Download CV</a>
      <a class="btn-ghost" href={`mailto:${SITE.email}`}>Email</a>
    </div>
  </section>
</BaseLayout>

<style>
  .approach-path {
    position: absolute;
    top: 0.7rem;
    bottom: 0.7rem;
    left: 0;
    width: 1px;
    background: var(--accent);
    transform-origin: top;
  }
</style>
