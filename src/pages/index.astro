---
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkCard from '../components/WorkCard.astro';
import PostItem from '../components/PostItem.astro';
import { getPosts, getWork } from '../utils';
import { SITE } from '../site';

const work = (await getWork()).filter((w) => w.data.featured);
const posts = (await getPosts()).slice(0, 3);

const stats = [
  { value: '18+', label: 'years building web & mobile products' },
  { value: '12', label: 'years owning a production design system' },
  { value: '39', label: 'product modules on one token foundation' },
  { value: '1 : 12', label: 'UI/CSS specialist to dev & QA team' },
];

const skills = [
  { title: 'UX & Interaction Design', items: ['User flows & journey maps', 'Wireframes & prototyping', 'Information architecture', 'Accessibility (WCAG)'] },
  { title: 'Design Systems', items: ['Design tokens & theming', 'Component libraries', 'Figma Variables & Auto Layout', 'Multi-brand themes'] },
  { title: 'Front-end Engineering', items: ['HTML, CSS, SCSS, Tailwind', 'Angular, React, React Native', 'TypeScript, Astro', 'Charts & SVG (Highcharts)'] },
  { title: 'AI-assisted Workflow', items: ['ChatGPT, Gemini, Claude', 'Cursor for code & refactors', 'Figma MCP for design ↔ code', 'Prompt-driven prototyping'] },
];
---

<BaseLayout>
  <section class="container-page pt-16 pb-20 sm:pt-24">
    <p class="eyebrow">UI/UX Designer · UX Engineer</p>
    <h1 class="mt-5 max-w-3xl text-4xl leading-[1.1] font-semibold tracking-tight text-balance sm:text-6xl">
      I design interfaces <span class="text-accent">and</span> build them.
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-muted text-pretty">
      I'm Thuy — a senior UI/UX designer with a front-end engineer's hands. For 18+ years I've turned complex business
      logic into clear, accessible interfaces, and kept them consistent with design systems that developers actually
      enjoy using.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/work/" class="btn-primary">View case studies</a>
      <a href={SITE.cv} class="btn-ghost">Download CV</a>
    </div>

    <dl class="mt-16 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-4">
      {
        stats.map((s) => (
          <div class="bg-surface p-5">
            <dt class="sr-only">{s.label}</dt>
            <dd class="text-3xl font-semibold tracking-tight text-accent">{s.value}</dd>
            <dd class="mt-1 text-sm text-muted">{s.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="container-page py-12" aria-labelledby="work-heading">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Selected work</p>
        <h2 id="work-heading" class="mt-2 text-3xl font-semibold tracking-tight">Case studies</h2>
      </div>
      <a href="/work/" class="text-sm font-medium text-accent hover:underline">All work →</a>
    </div>
    <div class="mt-8 grid gap-6 md:grid-cols-2">
      {work.map((entry, i) => <WorkCard entry={entry} priority={i < 2} />)}
    </div>
  </section>

  <section class="container-page py-12" aria-labelledby="skills-heading">
    <p class="eyebrow">What I do</p>
    <h2 id="skills-heading" class="mt-2 text-3xl font-semibold tracking-tight">Design and code, in one person</h2>
    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        skills.map((s) => (
          <div class="card p-5">
            <h3 class="font-semibold">{s.title}</h3>
            <ul class="mt-3 space-y-1.5 text-sm text-muted">
              {s.items.map((i) => (
                <li>{i}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container-page py-12" aria-labelledby="blog-heading">
    <div class="flex items-end justify-between gap-4">
      <div>
        <p class="eyebrow">Notes</p>
        <h2 id="blog-heading" class="mt-2 text-3xl font-semibold tracking-tight">From the blog</h2>
      </div>
      <a href="/blog/" class="text-sm font-medium text-accent hover:underline">All posts →</a>
    </div>
    <div class="mt-4">
      {posts.map((post) => <PostItem post={post} />)}
    </div>
  </section>
</BaseLayout>
